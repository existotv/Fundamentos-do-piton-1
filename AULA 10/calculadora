        
def soma(a,b):
    return a + b

def divisao(a,b):
    return a/ b

def multiplicacao(a,b):
    return a * b

def subtracao(a,b):
    return a - b

def calculadora():
    n1 =  float(input('nº >> '))
    op = input('+ | - | / | x')
    if op == '+':
        n2 = float(input('nº >> '))
        print(soma(n1, n2))
    
    elif op == '-':
        n2 = float(input('nº >> '))
        print(subtracao(n1, n2))
    elif op == 'x':
        n2 = float(input('nº >> '))
        print(multiplicacao(n1, n2))   
    elif op == '/':
        n2 = float(input('nº >> '))
        print(divisao(n1, n2))
    else:
        print('digite algo válido ...')
calculadora()     

