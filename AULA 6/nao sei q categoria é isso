lado1 = float(input('lado 1: '))
lado2 = float(input('lado 2: '))
lado3 = float(input('lado 3: '))

if lado1 == lado2 == lado3 == lado1:
    print('Equilatero')
elif  lado1 != lado2 != lado3 != lado1:
    print('Escaleno')
else:
    print('Isoceles')

